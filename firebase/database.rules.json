{
  "rules": {
    "skyhook": {
      "scores": {
        "$boardId": {
          ".read": "$boardId.matches(/^(level-([1-9]|[1-3][0-9]|40)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|weekly-[0-9]{4}-W[0-9]{2}|community-[A-Za-z0-9]{12})$/)",
          ".indexOn": [
            "time"
          ],
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('skyhook').child('members').child($uid).child(auth.uid).exists()) && $boardId.matches(/^(level-([1-9]|[1-3][0-9]|40)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|weekly-[0-9]{4}-W[0-9]{2}|community-[A-Za-z0-9]{12})$/)",
            ".validate": "newData.hasChildren(['name', 'time', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9 _.-]+$/)"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() < 3600 && (!data.exists() || newData.val() <= data.val())"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "ghosts": {
        "$boardId": {
          ".read": "$boardId.matches(/^(level-([1-9]|[1-3][0-9]|40)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|weekly-[0-9]{4}-W[0-9]{2}|community-[A-Za-z0-9]{12})$/)",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('skyhook').child('members').child($uid).child(auth.uid).exists()) && $boardId.matches(/^(level-([1-9]|[1-3][0-9]|40)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|weekly-[0-9]{4}-W[0-9]{2}|community-[A-Za-z0-9]{12})$/)",
            ".validate": "newData.hasChildren(['time', 'data', 'at']) && newData.child('time').val() === newData.parent().parent().parent().child('scores').child($boardId).child($uid).child('time').val()",
            "time": {
              ".validate": "newData.isNumber()"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length <= 200000 && (newData.val().beginsWith('G1.') || newData.val().beginsWith('G0.'))"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "levels": {
        ".read": true,
        ".indexOn": [
          "at"
        ],
        "$id": {
          ".write": "auth != null && (data.exists() ? (data.child('uid').val() === auth.uid || root.child('skyhook').child('members').child(data.child('uid').val()).child(auth.uid).exists()) : (newData.child('uid').val() === auth.uid || root.child('skyhook').child('members').child(newData.child('uid').val()).child(auth.uid).exists()))",
          ".validate": "$id.matches(/^[A-Za-z0-9]{12}$/) && newData.hasChildren(['uid', 'name', 'author', 'code', 'blocks', 'at']) && newData.child('at').val() === now && newData.parent().parent().child('publishers').child(auth.uid).val() === now && (!root.child('skyhook').child('publishers').child(auth.uid).exists() || now - root.child('skyhook').child('publishers').child(auth.uid).val() >= 60000)",
          "uid": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('skyhook').child('members').child(newData.val()).child(auth.uid).exists())"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          },
          "author": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9 _.-]+$/)"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 20000 && (newData.val().beginsWith('SKY1.') || newData.val().beginsWith('SKY0.'))"
          },
          "blocks": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "levelVotes": {
        ".read": true,
        "$id": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('skyhook').child('members').child($uid).child(auth.uid).exists())",
            ".validate": "newData.val() === true && root.child('skyhook').child('levels').child($id).exists()"
          }
        }
      },
      "publishers": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        }
      },
      "accounts": {
        "$code": {
          ".read": "auth != null && $code.matches(/^[2-9A-HJ-NP-Z]{16}$/)",
          ".write": "auth != null && newData.exists()",
          ".validate": "$code.matches(/^[2-9A-HJ-NP-Z]{16}$/) && newData.hasChildren(['pid', 'save', 'at']) && newData.child('pid').val() === (data.exists() ? data.child('pid').val() : auth.uid) && newData.child('at').val() === now && (!data.exists() || now - data.child('at').val() >= 2000)",
          "pid": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{1,128}$/)"
          },
          "save": {
            ".validate": "newData.isString() && newData.val().length <= 500000 && (newData.val().beginsWith('SV1.') || newData.val().beginsWith('SV0.'))"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "members": {
        "$pid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().matches(/^[2-9A-HJ-NP-Z]{16}$/) && root.child('skyhook').child('accounts').child(newData.val()).child('pid').val() === $pid"
          }
        }
      }
    }
  }
}
