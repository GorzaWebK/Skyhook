{
  "rules": {
    "skyhook": {
      "scores": {
        "$boardId": {
          ".read": "$boardId.matches(/^(level-([1-9]|[12][0-9]|30)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2})$/)",
          ".indexOn": [
            "time"
          ],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $boardId.matches(/^(level-([1-9]|[12][0-9]|30)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2})$/)",
            ".validate": "newData.hasChildren(['name', 'time', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && newData.val().matches(/^[A-Za-z0-9 _.-]+$/)"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() < 3600 && (!data.exists() || newData.val() <= data.val())"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "ghosts": {
        "$boardId": {
          ".read": "$boardId.matches(/^(level-([1-9]|[12][0-9]|30)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2})$/)",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $boardId.matches(/^(level-([1-9]|[12][0-9]|30)|daily-[0-9]{4}-[0-9]{2}-[0-9]{2})$/)",
            ".validate": "newData.hasChildren(['time', 'data', 'at']) && newData.child('time').val() === newData.parent().parent().parent().child('scores').child($boardId).child($uid).child('time').val()",
            "time": {
              ".validate": "newData.isNumber()"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length <= 200000 && (newData.val().beginsWith('G1.') || newData.val().beginsWith('G0.'))"
            },
            "at": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
